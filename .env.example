# Application
RAG_ENV=development
RAG_LOG_LEVEL=INFO

# LLM provider selection (implemented in Phase 6)
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=
# Choose an already installed Ollama model; no automatic downloads or service startup.
RAG_LLM_BASE_URL=http://localhost:11434
RAG_LLM_TIMEOUT_SECONDS=60
RAG_LLM_MAX_OUTPUT_TOKENS=2048
RAG_LLM_MAX_RESPONSE_BYTES=131072
RAG_MAX_EVIDENCE_CHARS=24000
RAG_MAX_EVIDENCE_CHUNKS=12
# Reserved for a future provider; the Ollama adapter does not use this key.
OPENAI_API_KEY=

# Vector database (implemented in Phase 4)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model (optional; falls back to BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=

# FastAPI (Phase 7); requires an existing indexed collection.
RAG_API_COLLECTION=rag_chunks
RAG_API_QDRANT_TIMEOUT=10
# Final top_k cannot exceed this count when rerank=true.
RERANKER_CANDIDATE_COUNT=20
# Use cached Hugging Face models only (no downloads).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
